{
  "name": "on-c",
  "private": true,
  "version": "1.0.0",
  "description": "on/c — Natural-language notepad calculator inspired by Numi",
  "license": "MIT",
  "author": "mj0lken",
  "homepage": "https://mj0lken.github.io/on-c/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mj0lken/on-c.git"
  },
  "bugs": {
    "url": "https://github.com/mj0lken/on-c/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "CARGO_TARGET_DIR=/tmp/onc-tauri-target node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "CARGO_TARGET_DIR=/tmp/onc-tauri-target node ./node_modules/@tauri-apps/cli/tauri.js build"
  },
  "dependencies": {
    "@microsoft/focusgroup-polyfill": "^1.6.0",
    "@oddbird/popover-polyfill": "^0.7.3",
    "@tauri-apps/api": "^2.2.0",
    "interestfor": "^1.0.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "temporal-polyfill": "^1.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
